msgid "plugins.generic.archiveMode.displayName"
msgstr "Archive Mode"

msgid "plugins.generic.archiveMode.description"
msgstr "Marks the journal as an archived copy once it has moved to a new home: a notice on every page, and no sign-in, registration, password reset or purchase. Switched on by [archive] moved_to in config.inc.php; does nothing while that is empty."

msgid "plugins.generic.archiveMode.bar.label"
msgstr "Archived site"

msgid "plugins.generic.archiveMode.bar.lead"
msgstr "This is an archived copy of the journal and is no longer in use."

msgid "plugins.generic.archiveMode.bar.text"
msgstr "The journal has moved to the SEA's website, {$site}. Please don't sign in, register, buy anything or reset a password here."

msgid "plugins.generic.archiveMode.link.article"
msgstr "Read this article on the SEA's website"

msgid "plugins.generic.archiveMode.link.issue"
msgstr "See this issue on the SEA's website"

msgid "plugins.generic.archiveMode.link.journal"
msgstr "Go to the journal on the SEA's website"

msgid "plugins.generic.archiveMode.closed.title"
msgstr "This archive is read only"

msgid "plugins.generic.archiveMode.closed.text"
msgstr "You can no longer sign in, register, buy articles or reset a password on this archived copy of the journal."

msgid "plugins.generic.archiveMode.closed.moved"
msgstr "The journal has moved to the SEA's website, {$site}. Members sign in there."
